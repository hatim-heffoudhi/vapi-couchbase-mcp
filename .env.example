# Copy to .env and fill the required values. Never commit .env.

# --- Required ---
# Private API key: https://dashboard.vapi.ai/org/api-keys
VAPI_API_KEY=

# --- Optional: in-page Call support ---
# Public key from the same Vapi page. If empty, npm start mints a short-lived web token from VAPI_API_KEY.
VAPI_PUBLIC_KEY=
# Optional. If empty, the app reads orgId from the created assistant.
VAPI_ORG_ID=

# --- Filled automatically on first npm start if empty ---
MCP_SHARED_TOKEN=
CB_USERNAME=Administrator
CB_PASSWORD=Administrator

# Couchbase MCP stays read-only. Date changes and cancels go through the shop API + supervisor UI.
CB_MCP_READ_ONLY_MODE=true

# --- Shop / seeded orders ---
CUSTOMER_NAME=Hatim Heffoudhi
DEMO_CUSTOMER_EMAIL=hatim@hatim.com

# --- Jack (Vapi assistant) ---
AGENT_NAME=How Couchbase Empowers CS
AGENT_VOICE_PROVIDER=cartesia
AGENT_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
AGENT_VOICE_MODEL=sonic-3.5
AGENT_VOICE_SPEED=1
AGENT_BACKGROUND_SOUND=office
AGENT_MODEL=gpt-4o

# --- Email ---
# Docker already sends OTP and confirmations to Mailpit (http://127.0.0.1:8025).
# Optional real inbox: https://resend.com
RESEND_API_KEY=
MAIL_FROM=Order Support <beth.t@example.com>
